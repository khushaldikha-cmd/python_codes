# --- never commit credentials ---------------------------------------------
# The scheduled scripts read credentials from a sibling folder outside this
# repo. These patterns are belt-and-braces in case anything is copied in.
*.pickle
*.pem
*.key
*_token*
*_Creds*
*_creds*
fcmservicetoken.json
.env
.env.*

# --- jupyter ---------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.py
*-checkpoint.ipynb

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- data and logs --------------------------------------------------------
# Script_Logs is written by the scheduled scripts and read by
# 0999_Send_Log_Mail.py. It is run output, not source.
Script_Logs/
*.csv
*.xlsx
*.log

# --- editors / os ---------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
